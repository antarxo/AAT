    "en": {
      "actTitle": "Act I: Kinematics in… Algebraic Form",
      "sbA": "Starring the oscillator (m₁, D₁) and the spect-actors(*)",
      "sbB": "in the monologue <span class=\"hl\">“endless back-and-forth”</span>… on stage!",
      "sbC": "Production & Direction: E_mech Energioulis",
      "sbD": "(*) … you",
      "measurementsTitle": "Measurements",
      "lawsTitle": "S.H.M. Laws",
      "actBreakTitle": "End of Act I",
      "actBreakMsg": "m,D keeps moving. Ready for Act II?",
      "act2Btn": "Start Act II",
      "thoughts": {
        "t1": "m1D1 was already moving!",
        "t2": "…time origin t₀=0 at the curtain opening!",
        "t3": "…the motion is linear and back-and-forth!",
        "t4": "…repeating, periodic — so it’s oscillation!",
        "t5": "Could it be Simple Harmonic Motion?",
        "t6": "…if it’s SHM, then x must match x=A·sin(ωt+φ₀)!",
        "t7": "…let’s plot x–t; that will confirm it!",
        "t11": "…thus v(t)=ωA·cos(ωt+φ₀)!",
        "t13": "…and a(t)=−ω²A·sin(ωt+φ₀)!",
        "t15": "But x=A·sin(ωt+φ₀) implies a=−ω²x!",
        "t18": "Perfect — the full SHM law set!"
      }
    }
