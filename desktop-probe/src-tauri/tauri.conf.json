{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AAT Desktop Probe",
  "version": "0.1.0",
  "identifier": "gr.antarxo.aat.desktopprobe",
  "build": {
    "beforeDevCommand": "node scripts/prepare-app.mjs",
    "beforeBuildCommand": "node scripts/prepare-app.mjs && node scripts/check-app.mjs",
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ΑΑΤ — Desktop Probe",
        "width": 1450,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Diagnostic-only desktop wrapper for AAT",
    "longDescription": "A diagnostic-only Windows desktop wrapper used to validate the ΑΑΤ educational application before any commercial hardening."
  }
}
