{
  "render": "plain",
  "params": {
    "m": 70,
    "T": 6.0,
    "A": 3.0
  },
  "proofs": [
    {
      "title": "Ελλειπτική σχέση στο επίπεδο (x, υ)",
      "steps": [
        {
          "type": "say",
          "text": "Ξεκινάμε από τη μορφή της κίνησης. Θέλω να συνδέσω θέση και ταχύτητα χωρίς το χρόνο."
        },
        {
          "type": "write",
          "text": "x(t) = A·ημ(ωt + φ₀)"
        },
        {
          "type": "write",
          "text": "υ(t) = ωA·συν(ωt + φ₀)"
        },
        {
          "type": "say",
          "text": "Κανονικοποιώ ως προς A και ωA, τετραγωνίζω και προσθέτω."
        },
        {
          "type": "derive",
          "text": "(x/A)² + (υ/(ωA))² = ημ²(ωt+φ₀) + συν²(ωt+φ₀) = 1"
        },
        {
          "type": "box",
          "text": "1 = x²/A² + υ²/(ω²A²)"
        },
        {
          "type": "say",
          "text": "Είναι έλλειψη στο (x, υ). Από εδώ διαβάζω άμεσα υ(x) = ± ω·√(A² − x²)."
        }
      ]
    },
    {
      "title": "Ελλειπτική σχέση στο επίπεδο (α, υ)",
      "steps": [
        {
          "type": "say",
          "text": "Τώρα δένω επιτάχυνση με ταχύτητα, ξανά χωρίς χρόνο."
        },
        {
          "type": "write",
          "text": "α(t) = −ω²A·ημ(ωt + φ₀)"
        },
        {
          "type": "write",
          "text": "υ(t) =  ωA·συν(ωt + φ₀)"
        },
        {
          "type": "say",
          "text": "Κανονικοποιώ α με ω⁴A² και υ με ω²A²."
        },
        {
          "type": "derive",
          "text": "(α/(ω²A))² + (υ/(ωA))² = ημ²(ωt+φ₀) + συν²(ωt+φ₀) = 1"
        },
        {
          "type": "box",
          "text": "1 = α²/(ω⁴A²) + υ²/(ω²A²)"
        },
        {
          "type": "say",
          "text": "Και αυτό είναι έλλειψη, τώρα στο (α, υ). Χρήσιμο για «προφητεία» δυναμικής από στιγμιαία κατάσταση."
        }
      ]
    },
    {
      "title": "Ενεργειακή διατύπωση (ΑΔΜΕ) από την ελλειπτική σχέση",
      "steps": [
        {
          "type": "say",
          "text": "Μεταφράζω την έλλειψη του (x, υ) σε ενέργειες. Θα προκύψει η ΑΔΜΕ."
        },
        {
          "type": "write",
          "text": "1 = x²/A² + υ²/(ω²A²)"
        },
        {
          "type": "derive",
          "text": "ω²A² = ω²x² + υ²"
        },
        {
          "type": "say",
          "text": "Πολλαπλασιάζω με ½·m και αναγνωρίζω K και U."
        },
        {
          "type": "derive",
          "text": "½mω²A² = ½mω²x² + ½mυ²"
        },
        {
          "type": "derive",
          "text": "Θέτω D = mω² ⇒ ½DA² = ½Dx² + ½mυ²"
        },
        {
          "type": "box",
          "text": "E = ½DA² = ½Dx² + ½mυ² (σταθερό)"
        },
        {
          "type": "say",
          "text": "Η οριζόντια γραμμή E στο διάγραμμα είναι το «budget» της παράστασης. Το μοίρασμα K–U αλλάζει, το σύνολο όχι."
        }
      ]
    },
    {
      "title": "Δύναμη και δυναμική ενέργεια: F = −dU/dx",
      "steps": [
        {
          "type": "say",
          "text": "Κλείνω το κύκλο: η δύναμη προκύπτει ως κλίση της U(x)."
        },
        {
          "type": "write",
          "text": "U(x) = ½Dx²"
        },
        {
          "type": "derive",
          "text": "dU/dx = Dx"
        },
        {
          "type": "box",
          "text": "F(x) = − dU/dx = −Dx"
        },
        {
          "type": "say",
          "text": "Άρα το ευθύγραμμο F–x έχει κλίση −D. Ταιριάζει με τη 2η πράξη και δένει τη Δυναμική με την Ενέργεια."
        }
      ]
    }
  ]
}